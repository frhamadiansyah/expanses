<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  How an archive becomes the .ipa that goes to App Store Connect. Kept in the repo so the build is the same
	  every time and nobody has to remember which boxes Xcode's Organizer had ticked.

	  It holds no secret: the API key that authorises the upload is passed on the command line and lives outside
	  this repository.
	-->
	<key>method</key>
	<string>app-store-connect</string>
	<!--
	  Named rather than inferred. This Mac also holds a second team — an employer's — and an archive signed with
	  it would be that organisation publishing this app.
	-->
	<key>teamID</key>
	<string>JPMPS53HUZ</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Symbols go up with the build, so a crash report names a function instead of an address. -->
	<key>uploadSymbols</key>
	<true/>
	<!--
	  Write the .ipa out rather than upload from here. The upload is its own step, so a failure is attributable
	  to one thing: the archive, the export, or App Store Connect.
	-->
	<key>destination</key>
	<string>export</string>
	<!--
	  Off on purpose. Bitcode is long dead, and thinning a store build hides which slice a crash came from.
	-->
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
