<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same shared container as the app: the medium widget reads the spending summary the app writes there,
	     and only while that is switched on in the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cicis.app</string>
	</array>
</dict>
</plist>
