<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud backup: the app's own container in iCloud Drive (ICloudBackupPlugin.swift). The container id is permanent. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.cicis.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.cicis.app</string>
	</array>
	<!-- The shortcuts and the share extension run where the app's database is not reachable, so captures wait in
	     this shared container until the app drains them. Nothing else is in it, and nothing in it is synced. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cicis.app</string>
	</array>
	<!-- NFC e-money reader (spike, Nfc/EmoneyReaderPlugin.swift): an NFCTagReaderSession reads raw ISO7816 tags, so
	     the TAG format is requested. The App ID needs the "NFC Tag Reading" capability for this to sign; automatic
	     signing with -allowProvisioningUpdates may add it, otherwise it is enabled once in the developer portal. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
