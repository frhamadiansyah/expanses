<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Expanses collects nothing. There is no account, no server and no analytics: every figure a person records
	  stays in a SQLite database in this app's own storage, and the only way anything leaves the device is a
	  backup the person asks for and hands to the share sheet themselves.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!--
	  The required-reason APIs this app reaches, and why. Both are reached through Capacitor's Filesystem
	  plugin rather than by our own code: a backup is written to the cache directory before it is shared, and
	  UserDefaults holds the plugin's own small settings.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: timestamps of files inside this app's own container, and no other. -->
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read and written only by this app, for its own settings. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
