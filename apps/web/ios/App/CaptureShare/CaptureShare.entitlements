<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same shared container as the app: a capture written here waits where the app will drain it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cicis.app</string>
	</array>
</dict>
</plist>
